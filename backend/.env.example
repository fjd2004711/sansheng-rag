# self_correcting_rag Environment Variables

# === Project ===
PROJECT_NAME=self_correcting_rag
DEBUG=true
DB_ECHO=false  # Set to true to log SQL queries
ENVIRONMENT=local
TIMEZONE=Asia/Shanghai  # IANA timezone: UTC, Europe/Warsaw, America/New_York
MODELS_CACHE_DIR=./models_cache


# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=self_correcting_rag

# === JWT Auth ===
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# === API Key Auth ===
API_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key

# === RAG Configuration ===
RAG_DEFAULT_COLLECTION=documents
RAG_TOP_K=10
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_CHUNKING_STRATEGY=recursive  # recursive, markdown, or fixed
RAG_HYBRID_SEARCH=false  # Enable BM25 + vector hybrid search
RAG_RERANKER_ENABLED=false  # P1: LLM relevance reranking after RRF
RAG_RERANKER_MODEL=  # Defaults to AI_MODEL when enabled
RAG_RERANKER_CANDIDATE_LIMIT=12
RAG_ENABLE_OCR=false  # OCR scanned/image-only PDF pages with a vision model
RAG_OCR_MODEL=  # e.g. qwen-vl-ocr (DashScope/MaaS) or qwen3-vl:8b-instruct (Ollama); OCR stays off while empty
RAG_OCR_BASE_URL=  # Defaults to OPENAI_BASE_URL (Ollama: http://host.docker.internal:11434/v1)
RAG_OCR_API_KEY=  # Defaults to OPENAI_API_KEY
# Research mode (联网调研): web search → fetch → per-run index → cited answer → claim verification
RESEARCH_SEARCH_PROVIDER=bocha  # bocha (mainland China) | tavily
RESEARCH_SEARCH_API_KEY=  # Research mode is unavailable while empty
RESEARCH_MAX_QUERIES=3
RESEARCH_RESULTS_PER_QUERY=6
RESEARCH_MAX_PAGES=8
RESEARCH_EVIDENCE_TOP_K=10
RESEARCH_FETCH_TIMEOUT_SECONDS=10
RESEARCH_FETCH_MAX_BYTES=3000000
RESEARCH_MAX_SUPPLEMENTAL_SEARCHES=1
# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_HTTPS=false
QDRANT_TIMEOUT_SECONDS=30
QDRANT_API_KEY=


# === AI Agent (langchain, openai) ===
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.5
AI_TEMPERATURE=0.7
# Embeddings
# OpenAI Embeddings
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1536

# Chunking
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# Retrieval
RAG_DEFAULT_COLLECTION=documents
RAG_TOP_K=10

# Reranker

# PDF Parser

# Google Drive (optional, for document ingestion)

# === CORS ===
# JSON list of allowed origins (default: localhost:3000, localhost:8080)
# Note: "*" is blocked in production - specify explicit origins
CORS_ORIGINS=["http://localhost:3010","http://localhost:8010"]

# === Docker Production (Traefik) ===
# Domain for production deployment
DOMAIN=example.com

# Let's Encrypt email for SSL certificates
ACME_EMAIL=admin@example.com

# Traefik dashboard auth (generate with: htpasswd -nb admin password)
# TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...
